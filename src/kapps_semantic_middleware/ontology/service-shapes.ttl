@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix cfc: <http://w3id.org/circularfactory/Core#> .
@prefix svc: <http://w3id.org/circularfactory/Service#> .

#################################################################
# The shapes of the service ontology.
#
# Every Operation has exactly one status, one of queued, running, done and failed. The status
# is written in the commit that creates the Operation and replaced atomically after, so a store
# that validates these shapes refuses at commit an Operation without a status, with two
# statuses, or with another value. The shape targets the Core Operation class, so it covers
# every subclass of it.
#
# A store that already holds its ontologies and shapes needs nothing from this file. It is for
# seeding a demonstration or test store, and as documentation, like service.ttl beside it.
#################################################################

svc:OperationShape a sh:NodeShape ;
    sh:targetClass cfc:Operation ;
    sh:property svc:OperationStatusShape .

svc:OperationStatusShape a sh:PropertyShape ;
    sh:path svc:hasOperationStatus ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( "queued" "running" "done" "failed" ) .
