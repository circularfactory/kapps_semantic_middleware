@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix cfc: <https://w3id.org/circularfactory/Core#> .
@prefix mes: <https://w3id.org/circularfactory/MES#> .

#################################################################
# Ontology
#
# MES (Manufacturing Execution System): a domain ontology that imports the
# Core ontology (cfc:) and details it out with manufacturing-execution
# functionality. Core is superior and is imported and specialized, never
# modified (ontology-module layering). This
# module is domain-facing — the vocabulary domain experts touch — and is a
# sibling to the reachability/coordination module svc:, which both import Core.
#
# v1 scope (the handover primitive): a handover-ability tag with
# six enumerated individuals. Possession is NOT re-minted here — it is Core material-flow
# state (cfc:PossessionState / cfc:hasPossessor / cfc:hasPossessedWorkpiece; verified
# against Core 0.9.0). Deliberately NO ability classes beyond the single tag class, NO
# liveness, NO Place, NO topology model.
#################################################################

mes: rdf:type owl:Ontology ;
    rdfs:label "KAPPS MES Ontology" ;
    rdfs:comment "Manufacturing-execution functionality layered on the Circular Factory Core ontology: which handover roles a Resource is able to take part in (handover ability). Possession itself is Core material-flow state (cfc:PossessionState), not re-minted here. A domain-facing module that imports and specializes Core; distinct from the middleware-facing reachability/coordination module svc:." ;
    owl:imports <https://w3id.org/circularfactory/Core> .

#################################################################
# Handover ability
#
# A tag on a Resource naming a handover role it can perform. The six roles form
# three complementary pairs (Elfaham & Epple, at–Automatisierungstechnik 68(3) 2020,
# section 3.3 and figure 2): Put↔Receive, Pick↔Release, Pass↔Retrieve. Each pair is
# named for the procedure it realises — a put-procedure, a pick-procedure, a
# pass-procedure — and the pair says which side gives and which side takes.
#
# A pair does NOT say which side is physically active. That is a property of the
# resource in the role, not of the ability, and it is deliberately not modelled here.
# Elfaham & Epple call an ability active when it needs control logic beyond the
# physical means and passive when the physical means suffice (section 4), and the
# same ability can be either: a shelf receives passively, while a sorting station
# must stop its drive to receive and so receives actively (Fischer et al., LDIC 2020,
# section 4.3). Read a comment below as the role in the procedure, never as a claim
# about actuation.
#
# The handover primitive's precondition check verifies that the counterpart carries
# the ability COMPLEMENTARY to the caller's mode; mes:complements encodes those pairs
# so that mapping is ontology ground truth, not code-only.
#################################################################

mes:HandoverAbility rdf:type owl:Class ;
    rdfs:label "HandoverAbility" ;
    rdfs:comment "The kind of handover role a Resource can take part in. Enumerated: exactly the six individuals below — no subclasses (handover abilities are not modeled as Capability subclasses in v1)." ;
    owl:oneOf ( mes:Put mes:Receive mes:Pick mes:Release mes:Pass mes:Retrieve ) .

mes:hasHandoverAbility rdf:type owl:ObjectProperty ;
    rdfs:label "hasHandoverAbility" ;
    rdfs:comment "Tags a Resource with a handover ability it can perform (one of the six mes:HandoverAbility individuals). Read by the handover primitive to check that a counterpart holds the complementary ability for the requested mode." ;
    rdfs:domain cfc:Resource ;
    rdfs:range mes:HandoverAbility .

mes:complements rdf:type owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:label "complements" ;
    rdfs:comment "Pairs each handover ability with the ability the counterpart must hold for a handover of that mode to be possible. Symmetric; relates the three complementary pairs." ;
    rdfs:domain mes:HandoverAbility ;
    rdfs:range mes:HandoverAbility .

#################################################################
# The six handover-ability individuals (three complementary pairs)
#################################################################

mes:Put rdf:type mes:HandoverAbility ;
    rdfs:label "Put" ;
    rdfs:comment "The giving side of a put-procedure: it hands the workpiece over to the taking side. Complements Receive." ;
    mes:complements mes:Receive .

mes:Receive rdf:type mes:HandoverAbility ;
    rdfs:label "Receive" ;
    rdfs:comment "The taking side of a put-procedure: it takes possession of a workpiece the giving side hands over. Complements Put." ;
    mes:complements mes:Put .

mes:Pick rdf:type mes:HandoverAbility ;
    rdfs:label "Pick" ;
    rdfs:comment "The taking side of a pick-procedure: it takes the workpiece from the giving side itself. Complements Release." ;
    mes:complements mes:Release .

mes:Release rdf:type mes:HandoverAbility ;
    rdfs:label "Release" ;
    rdfs:comment "The giving side of a pick-procedure: it relinquishes a workpiece that the taking side comes and takes. Complements Pick." ;
    mes:complements mes:Pick .

mes:Pass rdf:type mes:HandoverAbility ;
    rdfs:label "Pass" ;
    rdfs:comment "The giving side of a pass-procedure, a joint handover: it carries the workpiece to a point beyond its own extent but within reach of the taking side. Both sides act, so both need control logic. Complements Retrieve." ;
    mes:complements mes:Retrieve .

mes:Retrieve rdf:type mes:HandoverAbility ;
    rdfs:label "Retrieve" ;
    rdfs:comment "The taking side of a pass-procedure, a joint handover: it performs the matching movement to retrieve the workpiece the giving side carried out to meet it. Complements Pass." ;
    mes:complements mes:Pass .
