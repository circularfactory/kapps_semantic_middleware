# The triple store connection for examples and demo.
# The store runs with security disabled in the local Docker image, so username/password
# are placeholders that the client merely requires.
#
# Only these three variables are read. The examples and the demo name their own
# dataset in code -- kapps-demo, the one docker/docker-compose.yml creates -- and the
# test suite names its own. A TRIPLESTORE_DATASET left in your environment is ignored by
# all of them, because whatever they connect to, they wipe and re-seed.
#
# WARNING: point TRIPLESTORE_URL at a store you are allowed to overwrite. The dataset is
# pinned, but the server is not. A host that is neither loopback nor a bare container alias is
# refused unless TRIPLESTORE_ALLOW_DESTRUCTIVE=1 is set.
TRIPLESTORE_URL=http://localhost:7200
TRIPLESTORE_USERNAME=admin
TRIPLESTORE_PASSWORD=root
